# Copy to .env.local and fill in your own keys from the Stripe Dashboard.
# Never commit .env.local.

# Secret key — Dashboard › Developers › API keys (use sk_test_... while testing)
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret — printed by `stripe listen` locally, or set in
# Dashboard › Developers › Webhooks for production (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxx
